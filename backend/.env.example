# Database — auto-set by Heroku Postgres add-on, or set manually for other providers
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret key — change this to a strong random string in production
SECRET_KEY=change-me-to-a-strong-random-secret

# Your deployed Vercel frontend URL (comma-separated for multiple)
FRONTEND_URL=https://your-app.vercel.app
